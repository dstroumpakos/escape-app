{
  "expo": {
    "name": "Unlocked",
    "slug": "escape-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "unlocked",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unlocked.escapeapp",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby escape rooms.",
        "NSPhotoLibraryUsageDescription": "Upload photos for your profile and social posts.",
        "NSLocationDefaultAccuracyReduced": true,
        "NSCameraUsageDescription": "Scan the QR code at the end of a game to get the room stamp in your passport."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#C20F1A"
      },
      "package": "com.unlocked.escapeapp",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA9Q-E4uWURr8x-LIci-ZGXQZlaCeHj9Pg"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4141F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Unlocked to use your location to find escape rooms near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Unlocked to access your photos for your profile and social posts."
        }
      ],
      "expo-iap",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Unlocked to use the camera to scan the QR code at the end of a game.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080505"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/63ddda73-e173-4fb4-a368-c4cc5652e509",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "extra": {
      "eas": {
        "projectId": "63ddda73-e173-4fb4-a368-c4cc5652e509"
      }
    },
    "owner": "dstroump"
  }
}
